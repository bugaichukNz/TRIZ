# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROXY_URL=
LLM_MODEL=gpt-4o-mini

# Frontend (Streamlit)
BACKEND_URL=http://localhost:8000

# История анализов и диалогов (SQLite)
DATABASE_URL=sqlite:///data/sessions/triz.db
HISTORY_MAX_ENTRIES=20
CHAT_SESSIONS_MAX=50

# Аутентификация (обязательно)
# Сгенерируйте секрет: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Сидирование пользователя user (только для локальной разработки)
SEED_DEFAULT_USER=false
# Пароль для user; если пусто — генерируется случайный и выводится в лог при первом создании
DEFAULT_USER_PASSWORD=

# RAG по корпусу физэффектов при генерации решений (включён по умолчанию;
# отключение — false, например если не собран индекс эффектов)
EFFECTS_RAG_ENABLED=true
# Порог cosine similarity для отбора эффектов (калибровка: scripts/calibrate_retriever.py)
EFFECTS_SCORE_THRESHOLD=0.40

# DOCX-отчёт (опционально)
REPORT_ANALYST_NAME=TRIZ AI-Ассистент
